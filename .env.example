POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-different-long-random-password
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Optional existing or Compose-managed Crawl4AI service (Markdown extraction)
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=

# Local AI wiki worker; Ollama runs on the Docker host by default
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
